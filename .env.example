# Example environment variables for Vercel deployment
# Copy this file to .env for local development

# Production flags
NODE_ENV=production

# API Keys
ADMIN_API_KEY=your_admin_api_key_here

# Telegram Bot Tokens
ADMIN_BOT_TOKEN=your_admin_bot_token_here
USER_BOT_TOKEN=your_user_bot_token_here

# API Config
DEFAULT_EXTRACTION_URL=https://oplij.koyeb.app/api/v1/getStream