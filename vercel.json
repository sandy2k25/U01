{
  "version": 2,
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/secure-player(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "server/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "ADMIN_API_KEY": "@admin_api_key",
    "ADMIN_BOT_TOKEN": "@admin_bot_token",
    "USER_BOT_TOKEN": "@user_bot_token",
    "DEFAULT_EXTRACTION_URL": "https://oplij.koyeb.app/api/v1/getStream",
    "TMDB_API_KEY": "@tmdb_api_key"
  }
}