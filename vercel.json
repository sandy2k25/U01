{
  "version": 2,
  "builds": [
    {
      "src": "vercel-build.js",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "node vercel-build.js"
      }
    },
    {
      "src": "server/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "dist/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/secure-player(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|svg|ico|json))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "ADMIN_API_KEY": "@admin_api_key",
    "ADMIN_BOT_TOKEN": "@admin_bot_token",
    "USER_BOT_TOKEN": "@user_bot_token",
    "DEFAULT_EXTRACTION_URL": "https://oplij.koyeb.app/api/v1/getStream"
  }
}